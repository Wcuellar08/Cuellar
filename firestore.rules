rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myProfile() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isActive() { return signedIn() && exists(myProfile()) && get(myProfile()).data.active == true; }
    function isOwner() { return isActive() && get(myProfile()).data.role == 'duena'; }

    // Indica si la app ya tiene dueña (lo lee la pantalla de entrada).
    match /meta/public {
      allow read: if true;
      // Solo se crea una vez: cuando la primera persona configura la app y queda como dueña.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(myProfile()).data.role == 'duena';
      allow update, delete: if false;
    }

    // Perfiles de usuario: nombre, rol (duena / ayudante) y si está activo.
    match /users/{uid} {
      allow read: if isActive();
      allow create: if isOwner()
        || (signedIn() && uid == request.auth.uid
            && !exists(/databases/$(database)/documents/meta/public)
            && existsAfter(/databases/$(database)/documents/meta/public)
            && request.resource.data.role == 'duena'
            && request.resource.data.active == true);
      allow update, delete: if isOwner();
    }

    // Contraseñas de los usuarios: solo la dueña las ve.
    match /secrets/{uid} {
      allow read, write: if isOwner();
    }

    match /settings/{doc} {
      allow read: if isActive();
      allow write: if isOwner();
    }

    match /items/{id} {
      allow read, create, update: if isActive();
      allow delete: if isOwner();
    }

    match /sales/{id} {
      allow read, create, update: if isActive();
      allow delete: if isOwner();
    }

    match /counters/{id} {
      allow read, write: if isActive();
    }
  }
}
